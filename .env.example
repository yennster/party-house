# App Store Connect API authentication for fastlane (all gitignored).
#
# Preferred: drop a fastlane-format JSON key at the repo root as `api_key.json`
# (fields: key_id, issuer_id, key, duration, in_house) — the fastlane lanes pick
# it up automatically and you don't need this file at all.
#
# Alternative: copy this file to `.env` and fill in the values below.
# Create keys at https://appstoreconnect.apple.com/access/integrations/api

APP_STORE_CONNECT_API_KEY_KEY_ID=ABC123XYZ
APP_STORE_CONNECT_API_KEY_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Base64 of the .p8 file: base64 -i AuthKey_ABC123XYZ.p8 | pbcopy
APP_STORE_CONNECT_API_KEY_KEY=base64-encoded-p8-contents
APP_STORE_CONNECT_API_KEY_IS_KEY_CONTENT_BASE64=true
