# Swift Package Manager
# NOTE: do NOT ignore Packages/ wholesale — Packages/PartyHouseKit is this app's
# entire source. Only build artifacts are ignored.
.build/
.swiftpm/
Packages/PartyHouseKit/.build/
Packages/PartyHouseKit/.swiftpm/

# Generated by xcodegen — regenerate with Scripts/bootstrap.sh
PartyHouse.xcodeproj/

# CocoaPods (unused but defensive)
Pods/
Podfile.lock

# fastlane — App Store release tooling (Fastfile, metadata, screenshots, keys)
# is kept LOCAL only and intentionally not tracked in this public repo.
/fastlane/

# Secrets / signing
*.p8
*.p12
*.mobileprovision
*.certSigningRequest
api_key.json
AuthKey*

# Python venv for screenshot framing
bin/.venv/
__pycache__/

# Local tool scratch dirs
.antigravitycli/
cache/

# Environment
.env
.env.*
!.env.example

# Screenshot output (regenerable via Scripts/screenshots-*.sh)
Screenshots/
*.xcresult

# Local-only App Store assets (also covered by /fastlane/)
AppStore/

# Marketing build output (regenerable)
Marketing/framed/
